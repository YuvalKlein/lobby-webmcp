{
  "_source": "unitism-backend openapi.json — generated by the backend from its own DTOs, and CI-enforced to match them (openapi-drift-check.yml). Refresh with test/extract-booking-schema.mjs; do not hand-edit.",
  "components": {
    "schemas": {
      "LobbyBookingOptionsDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "nullable": true
          },
          "booking_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LobbyBookingTypePublicDto"
            }
          }
        },
        "required": [
          "timezone",
          "booking_types"
        ]
      },
      "LobbyBookingTypePublicDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number"
          },
          "location_kind": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "nullable": true,
            "description": "A label a visitor can read. Lobby never charges for it (design §9.2)."
          },
          "currency": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "duration_minutes",
          "location_kind",
          "price",
          "currency"
        ]
      },
      "LobbyAvailabilityDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "The BUSINESS's IANA zone — the booking type's own, not the visitor's.\n\nRequired by `check_availability`'s output schema, absent from this response\nuntil 2026-09-01, and defaulted client-side to `'UTC'`: every visiting agent\nwas told this concierge runs on UTC. `start_local` is the field rendered in\nthe visitor's zone; this is the one that says where the business is."
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LobbyBookingSlotDto"
            }
          }
        },
        "required": [
          "timezone",
          "slots"
        ]
      },
      "LobbyBookingSlotDto": {
        "type": "object",
        "properties": {
          "start_utc": {
            "type": "string",
            "description": "Absolute instant. Pass back unmodified to book it."
          },
          "end_utc": {
            "type": "string"
          },
          "start_local": {
            "type": "string",
            "description": "Human-readable, in the requested zone. A courtesy, never the identity.\n\n**Was `display` until 2026-09-01.** `check_availability`'s output schema has\nalways published this as `start_local`, so an agent read `undefined` off\nevery slot and no test noticed — the tool's own fixture was hand-written to\nthe schema rather than captured from this endpoint. Renamed here rather than\nin the schema, because the schema is the published contract."
          }
        },
        "required": [
          "start_utc",
          "end_utc",
          "start_local"
        ]
      },
      "LobbyBookingCreatedDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "booking_type_id": {
            "type": "string"
          },
          "booking_type_name": {
            "type": "string",
            "description": "The booking type's name, so a caller can say WHAT was booked.\n\nAdded 2026-09-01 because `start_booking` was already reading it — the tool\nbuilds a summary it reads back to the visitor and fell back to\n`String(booking_type_id)`, so a person was shown a UUID where the service\nname belonged. The id alone forces a second request to say \"15-minute\ndemo\", on a response that has the type in hand."
          },
          "duration_minutes": {
            "type": "number",
            "description": "Same reason: the summary states the length of the appointment."
          },
          "starts_at": {
            "type": "string"
          },
          "ends_at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "guest_name": {
            "type": "string"
          },
          "guest_email": {
            "type": "string"
          },
          "cancel_token": {
            "type": "string",
            "description": "The guest's cancellation credential.\n\n**Returned here and nowhere else.** It is `select: false` on the entity and\nabsent from every owner-facing response, because a bookings list carrying it\nwould hand an owner the cancel link for each of their guests."
          }
        },
        "required": [
          "id",
          "booking_type_id",
          "booking_type_name",
          "duration_minutes",
          "starts_at",
          "ends_at",
          "status",
          "guest_name",
          "guest_email",
          "cancel_token"
        ]
      }
    }
  },
  "paths": {
    "/lobby/agents/{slug}/booking/options": {
      "get": {
        "operationId": "LobbyBookingPublicController_options",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyBookingOptionsDto"
                }
              }
            }
          }
        }
      }
    },
    "/lobby/agents/{slug}/booking/availability": {
      "get": {
        "operationId": "LobbyBookingPublicController_availability",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyAvailabilityDto"
                }
              }
            }
          }
        }
      }
    },
    "/lobby/agents/{slug}/booking/bookings": {
      "post": {
        "operationId": "LobbyBookingPublicController_create",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyBookingCreatedDto"
                }
              }
            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyBookingCreatedDto"
                }
              }
            }
          }
        }
      }
    }
  }
}
